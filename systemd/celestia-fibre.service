[Unit]
Description=Celestia Fibre server
After=network-online.target celestia-appd.service
Wants=network-online.target

[Service]
# Change User and --home to match your host. Keep the Fibre home on its own disk.
User=celestia
ExecStart=/usr/local/bin/fibre start \
  --home /var/lib/celestia-fibre \
  --app-grpc-address 127.0.0.1:9090 \
  --signer-grpc-address 127.0.0.1:26669 \
  --server-listen-address 0.0.0.0:7980
# Fibre exits on an unexpected gRPC server failure; systemd brings it back.
Restart=on-failure
RestartSec=5
# The first SIGTERM drains gracefully; give it time before systemd escalates.
TimeoutStopSec=60
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
